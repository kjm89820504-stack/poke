rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /runs/{runId} {
      allow create: if request.resource.data.keys().hasOnly([
          'type',
          'stage',
          'elapsedSeconds',
          'stageSeconds',
          'obstacleCount',
          'completed',
          'browserId',
          'userAgent',
          'createdAt'
        ])
        && request.resource.data.type in [
          'stage_start',
          'stage_clear',
          'stage_fail',
          'all_clear'
        ]
        && request.resource.data.stage is int
        && request.resource.data.stage >= 1
        && request.resource.data.stage <= 5
        && request.resource.data.elapsedSeconds is number
        && request.resource.data.stageSeconds is number
        && request.resource.data.stageSeconds <= 300
        && request.resource.data.obstacleCount is number
        && request.resource.data.completed is bool
        && request.resource.data.browserId is string
        && request.resource.data.browserId.size() <= 80
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 120
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }
  }
}
